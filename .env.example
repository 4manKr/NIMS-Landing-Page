# Copy these into Vercel → Settings → Environment Variables (see SETUP-OTP.md)
SMS_API_KEY=your-seo-age-digital-auth-key
SMS_SENDER_ID=MBBSAD
SMS_TEMPLATE={otp} is your OTP to verify your mobile number for MBBS admission enquiry. Valid for 10 minutes. - MBBSAD
OTP_SECRET=replace-with-a-long-random-string
LEAD_WEBHOOK_URL=https://script.google.com/macros/s/XXXXXXXX/exec

# Optional
# SMS_API_URL=http://sms.seoagedigital.com/API/sms-api.php
# SMS_TEMPLATE_ID=
# SMS_ENTITY_ID=
# OTP_LENGTH=6
