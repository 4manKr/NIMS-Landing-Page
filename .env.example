# Vercel → Settings → Environment Variables (see SETUP-OTP.md)
# Required
SMS_API_KEY=your-seo-age-digital-auth-key
OTP_SECRET=replace-with-a-long-random-string

# Optional — Google Sheet for leads
LEAD_WEBHOOK_URL=https://script.google.com/macros/s/XXXXXXXX/exec

# Optional — only when switching to a different DLT-approved template/header.
# Defaults (built in): TABEDU / 1701160277700802420 / 1707163145165961393 / the approved TAB INDIA OTP text.
# SMS_SENDER_ID=TABEDU
# SMS_ENTITY_ID=1701160277700802420
# SMS_TEMPLATE_ID=1707163145165961393
# SMS_TEMPLATE=Thanks for registering with us. Your OTP to register/access TAB INDIA is {otp}. It will be valid till 5 minutes. -TAB INDIA (Admission Bureau)
